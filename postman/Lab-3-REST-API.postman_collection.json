    {
      "name": "03. Query Parameters & Filters",
      "item": [
        {
          "name": "Search Books (?search=python)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search=python",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "search",
                  "value": "python"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returned books match query\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.data.forEach(b => {",
                  "        const matches = b.title.toLowerCase().includes('python') || b.author.toLowerCase().includes('python');",
                  "        pm.expect(matches).to.be.true;",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Sort Books Ascending (?sort=asc)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?sort=asc",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "sort",
                  "value": "asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Prices are in ascending order\", function () {",
                  "    const data = pm.response.json().data;",
                  "    for (let i = 0; i < data.length - 1; i++) {",
                  "        pm.expect(data[i].price).to.be.at.most(data[i+1].price);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Sort Books Descending (?sort=desc)",
          "request": {
            "method": "GET",
            "header": [],
